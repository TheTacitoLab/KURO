# Site URL — used for metadata and OG image URLs
NEXT_PUBLIC_SITE_URL=https://obra.studio

# Form submission endpoint
# Options:
#   Formspree: https://formspree.io/f/YOUR_FORM_ID
#   Resend API route: /api/brief (create app/api/brief/route.ts)
#   Airtable: wire to /api/brief route
NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Plausible Analytics — leave empty to disable
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
